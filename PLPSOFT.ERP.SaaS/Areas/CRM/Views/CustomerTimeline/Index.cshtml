@model IEnumerable<PLPSOFT.ERP.SaaS.Modules.CRM.Application.DTOs.TimelineItemDto>
@{
    ViewData["Title"] = "Hồ sơ 360 độ khách hàng";
    // Layout = "~/Views/Shared/_Layout.cshtml"; // Bỏ comment nếu có layout
}

<div class="container-fluid">
    <div class="row">
        <!-- Khu vực thêm Ghi chú -->
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thêm Ghi chú (Customer Notes)</h6>
                </div>
                <div class="card-body">
                    <textarea id="txtNoteContent" class="form-control" rows="4" placeholder="Nhập ghi chú... vd: Khách thích được liên hệ buổi sáng"></textarea>
                    <button class="btn btn-primary mt-3 w-100" onclick="saveNote()">Lưu Ghi Chú</button>
                </div>
            </div>
        </div>

        <!-- Khu vực hiển thị Timeline -->
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Lịch sử tương tác (Customer Timeline)</h6>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        @if(Model == null || !Model.Any())
                        {
                            <p class="text-muted">Chưa có dữ liệu tương tác nào.</p>
                        }
                        else
                        {
                            @foreach(var item in Model)
                            {
                                <div class="card mb-3 @item.CssClass">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="font-weight-bold">
                                                <span class="badge badge-secondary">@item.EventBadge</span>
                                                @item.Title
                                            </h6>
                                            <small class="text-muted">@item.EventTime.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                        <p class="mb-0 mt-2">@item.Description</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function saveNote() {
        var content = $('#txtNoteContent').val();
        var customerId = @(ViewBag.CustomerID ?? 0);

        if (!content) {
            alert('Vui lòng nhập nội dung ghi chú');
            return;
        }

        $.ajax({
            url: '/CRM/CustomerTimeline/AddNote',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ CustomerID: customerId, Content: content }),
            success: function () {
                alert('Thêm ghi chú thành công');
                location.reload(); // Load lại để hiển thị ghi chú mới
            },
            error: function () {
                alert('Có lỗi xảy ra khi lưu ghi chú');
            }
        });
    }
</script>

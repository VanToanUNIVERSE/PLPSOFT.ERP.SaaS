@model IEnumerable<PLPSOFT.ERP.SaaS.Modules.CRM.Application.DTOs.TimelineItemDto>
@{
    ViewData["Title"] = "Hồ sơ 360° Khách hàng - Chi tiết";
    var notes = ViewBag.Notes as List<PLPSOFT.ERP.SaaS.Modules.CRM.Application.DTOs.CustomerNoteDto>;
}

<style>
    /* Timeline styling */
    .timeline-invoice  { border-left: 4px solid #1cc88a !important; }
    .timeline-feedback { border-left: 4px solid #e74a3b !important; }
    .timeline-schedule { border-left: 4px solid #4e73df !important; }
    .timeline-note     { border-left: 4px solid #f6c23e !important; }

    .badge-invoice  { background-color: #1cc88a; color: #fff; }
    .badge-feedback { background-color: #e74a3b; color: #fff; }
    .badge-schedule { background-color: #4e73df; color: #fff; }
    .badge-note     { background-color: #f6c23e; color: #212529; }
</style>

<div class="container-fluid mt-4">
    <!-- Nút quay lại danh sách -->
    <a asp-area="CRM" asp-controller="CustomerTimeline" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách khách hàng
    </a>

    <div class="row align-items-center mb-4">
        <div class="col-12">
            <h4 class="mb-0 text-dark fw-bold">
                <i class="fas fa-user-clock text-primary me-2"></i>
                Hồ sơ 360° Khách hàng (ID: @ViewBag.CustomerID)
            </h4>
        </div>
    </div>

    <div class="row">
        <!-- CỘT TRÁI: Thêm Ghi chú -->
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-warning text-dark">
                    <h6 class="m-0 fw-bold">📝 Thêm Ghi chú (Customer Notes)</h6>
                </div>
                <div class="card-body">
                    <textarea id="txtNoteContent" class="form-control" rows="4"
                        placeholder="Nhập ghi chú... VD: Khách thích được liên hệ buổi sáng"></textarea>
                    <button class="btn btn-warning mt-3 w-100" onclick="saveNote()">
                        💾 Lưu Ghi Chú
                    </button>
                </div>
            </div>

            <!-- Danh sách ghi chú hiện tại -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 fw-bold text-secondary">📋 Danh sách Ghi chú</h6>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    @if (notes == null || !notes.Any())
                    {
                        <p class="text-muted">Chưa có ghi chú nào.</p>
                    }
                    else
                    {
                        @foreach (var note in notes)
                        {
                            <div class="border-bottom pb-2 mb-2">
                                <small class="text-muted">@note.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                <p class="mb-0">@note.Content</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: Timeline -->
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-primary text-white">
                    <h6 class="m-0 fw-bold">⏱️ Lịch sử tương tác (Customer Timeline)</h6>
                </div>
                <div class="card-body">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <p>Chưa có dữ liệu tương tác nào.</p>
                            <p>Hãy thử thêm một Ghi chú ở bên trái.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Bộ lọc Timeline -->
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3 pb-3 border-bottom">
                            <span class="text-secondary fw-semibold me-2"><i class="fas fa-filter"></i> Lọc theo:</span>
                            
                            <input type="checkbox" class="btn-check" id="filter-note" checked autocomplete="off" onchange="applyTimelineFilter()">
                            <label class="btn btn-sm btn-outline-warning text-dark border-warning" for="filter-note">
                                📝 Ghi chú
                            </label>

                            <input type="checkbox" class="btn-check" id="filter-feedback" checked autocomplete="off" onchange="applyTimelineFilter()">
                            <label class="btn btn-sm btn-outline-danger" for="filter-feedback">
                                💬 Phản hồi
                            </label>

                            <input type="checkbox" class="btn-check" id="filter-schedule" checked autocomplete="off" onchange="applyTimelineFilter()">
                            <label class="btn btn-sm btn-outline-primary" for="filter-schedule">
                                📅 Lịch hẹn
                            </label>

                            <input type="checkbox" class="btn-check" id="filter-invoice" checked autocomplete="off" onchange="applyTimelineFilter()">
                            <label class="btn btn-sm btn-outline-success" for="filter-invoice">
                                💵 Hóa đơn
                            </label>
                            
                            <div class="ms-auto">
                                <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted py-0 px-1" onclick="toggleAllFilters(true)">
                                    Chọn tất cả
                                </button>
                                <span class="text-muted">|</span>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none text-danger py-0 px-1" onclick="toggleAllFilters(false)">
                                    Bỏ chọn
                                </button>
                            </div>
                        </div>

                        <div id="timeline-container">
                            @foreach (var item in Model)
                            {
                                var badgeClass = item.EventType switch
                                {
                                    "INVOICE" => "badge-invoice",
                                    "FEEDBACK" => "badge-feedback",
                                    "SCHEDULE" => "badge-schedule",
                                    "NOTE" => "badge-note",
                                    _ => "bg-secondary"
                                };

                                <div class="card mb-3 @item.CssClass timeline-item" data-event-type="@item.EventType">
                                    <div class="card-body py-2 px-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="badge @badgeClass me-1">@item.EventBadge</span>
                                                <strong>@item.Title</strong>
                                            </div>
                                            <small class="text-muted">@item.EventTime.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                        <p class="mb-0 mt-1 text-secondary">@item.Description</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function saveNote() {
            var content = document.getElementById('txtNoteContent').value;
            var customerId = @ViewBag.CustomerID;

            if (!content || !content.trim()) {
                alert('Vui lòng nhập nội dung ghi chú!');
                return;
            }

            fetch('@Url.Action("AddNote", "CustomerTimeline", new { area = "CRM" })', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ CustomerID: customerId, Content: content })
            }).then(function (res) {
                if (res.ok) {
                    alert('✅ Thêm ghi chú thành công!');
                    location.reload();
                } else {
                    alert('❌ Có lỗi xảy ra. Vui lòng thử lại.');
                }
            }).catch(function () {
                alert('❌ Không thể kết nối server.');
            });
        }

        function applyTimelineFilter() {
            const showNote = document.getElementById('filter-note').checked;
            const showFeedback = document.getElementById('filter-feedback').checked;
            const showSchedule = document.getElementById('filter-schedule').checked;
            const showInvoice = document.getElementById('filter-invoice').checked;

            const items = document.querySelectorAll('.timeline-item');
            let visibleCount = 0;

            items.forEach(item => {
                const type = item.getAttribute('data-event-type');
                let visible = false;
                if (type === 'NOTE' && showNote) visible = true;
                else if (type === 'FEEDBACK' && showFeedback) visible = true;
                else if (type === 'SCHEDULE' && showSchedule) visible = true;
                else if (type === 'INVOICE' && showInvoice) visible = true;

                if (visible) {
                    item.classList.remove('d-none');
                    visibleCount++;
                } else {
                    item.classList.add('d-none');
                }
            });

            let noDataMsg = document.getElementById('timeline-no-data-msg');
            if (visibleCount === 0) {
                if (!noDataMsg) {
                    const msgHtml = `
                        <div id="timeline-no-data-msg" class="text-center text-muted py-5">
                            <p><i class="fas fa-filter fa-2x mb-2 text-secondary"></i></p>
                            <p>Không tìm thấy lịch sử tương tác nào khớp với bộ lọc.</p>
                        </div>
                    `;
                    document.getElementById('timeline-container').insertAdjacentHTML('beforeend', msgHtml);
                }
            } else {
                if (noDataMsg) {
                    noDataMsg.remove();
                }
            }
        }

        function toggleAllFilters(checked) {
            document.getElementById('filter-note').checked = checked;
            document.getElementById('filter-feedback').checked = checked;
            document.getElementById('filter-schedule').checked = checked;
            document.getElementById('filter-invoice').checked = checked;
            applyTimelineFilter();
        }
    </script>
}

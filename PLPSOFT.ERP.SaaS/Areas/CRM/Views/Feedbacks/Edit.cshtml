@model PLPSOFT.ERP.SaaS.Modules.CRM.Application.DTOs.Feedback.UpdateFeedbackDto

@{
    ViewData["Title"] = "Cập nhật Phản hồi";
    var formData = ViewBag.FormData as PLPSOFT.ERP.SaaS.Modules.CRM.Application.DTOs.Feedback.FeedbackFormDataDto;
    var detail = ViewBag.Detail as PLPSOFT.ERP.SaaS.Modules.CRM.Application.DTOs.Feedback.FeedbackDetailDto;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Cập nhật Phản hồi / Khiếu nại #@Model.FeedbackID</h1>
        <a asp-action="Index" class="btn btn-secondary btn-sm shadow-sm"> Quay lại danh sách</a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-primary">Thông tin chi tiết và Chỉnh sửa</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.FeedbackID" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FeedbackID" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label font-weight-bold">Khách hàng</label>
                        <input type="text" class="form-control bg-light" value="@detail?.CustomerName" readonly>
                        <small class="text-muted">Không được phép đổi khách hàng sau khi tạo.</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StatusID" class="form-label font-weight-bold">Trạng thái xử lý <span class="text-danger">*</span></label>
                        <select asp-for="StatusID" class="form-select border-primary" required>
                            @if (formData?.Statuses != null)
                            {
                                foreach (var item in formData.Statuses)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="StatusID" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="FeedbackTypeID" class="form-label font-weight-bold">Loại phản hồi <span class="text-danger">*</span></label>
                        <select asp-for="FeedbackTypeID" class="form-select" required>
                            @if (formData?.FeedbackTypes != null)
                            {
                                foreach (var item in formData.FeedbackTypes)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="FeedbackTypeID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PriorityID" class="form-label font-weight-bold">Mức độ ưu tiên <span class="text-danger">*</span></label>
                        <select asp-for="PriorityID" class="form-select" required>
                            @if (formData?.Priorities != null)
                            {
                                foreach (var item in formData.Priorities)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="PriorityID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="InvoiceID" class="form-label font-weight-bold">Hóa đơn (Nếu có)</label>
                        <select asp-for="InvoiceID" class="form-select">
                            <option value="">-- Chọn hóa đơn --</option>
                            @if (formData?.Invoices != null)
                            {
                                foreach (var item in formData.Invoices)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="InvoiceID" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="Rating" class="form-label font-weight-bold">Đánh giá (1-5) <span class="text-danger">*</span></label>
                        <input asp-for="Rating" type="number" class="form-control" min="1" max="5" required>
                        <span asp-validation-for="Rating" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label font-weight-bold">Tiêu đề</label>
                    <input asp-for="Title" type="text" class="form-control" required>
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label font-weight-bold">Nội dung phản hồi</label>
                    <textarea asp-for="Content" class="form-control" rows="4" required></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Details" asp-route-id="@Model.FeedbackID" class="btn btn-secondary me-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">Cập nhật thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

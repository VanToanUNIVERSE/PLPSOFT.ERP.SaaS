    @model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Danh sách Lịch chăm sóc";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Quản lý Lịch làm việc & Nhắc hẹn</h1>
        <a href="@Url.Action("Create", "Schedules")" class="btn btn-success shadow-sm">
            <i class="fas fa-calendar-plus fa-sm text-white-50"></i> Tạo lịch hẹn mới
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <form class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Trạng thái</label>
                    <select class="form-select border-left-info">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="PLANNED">Đã lên lịch (PLANNED)</option>
                        <option value="COMPLETED">Hoàn thành (COMPLETED)</option>
                        <option value="CANCELED">Đã hủy (CANCELED)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Loại lịch</label>
                    <select class="form-select">
                        <option value="">-- Tất cả loại --</option>
                        <option value="CALL">Gọi điện (CALL)</option>
                        <option value="MEETING">Gặp mặt (MEETING)</option>
                        <option value="REORDER">Nhắc mua lại (REORDER)</option>
                        <option value="SERVICE">Chăm sóc/Bảo trì (SERVICE)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Thời gian</label>
                    <div class="input-group">
                        <input type="date" class="form-control" title="Từ ngày">
                        <span class="input-group-text">đến</span>
                        <input type="date" class="form-control" title="Đến ngày">
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-secondary w-100">Lọc lịch</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-success">Lịch làm việc chi tiết</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Thời gian bắt đầu</th>
                            <th>Tiêu đề công việc</th>
                            <th>Khách hàng</th>
                            <th>Loại lịch</th>
                            <th>Người phụ trách</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StartTime</td>
                                    <td><strong>@item.Title</strong></td>
                                    <td>@item.CustomerName</td>
                                    <td><span class="badge bg-info">@item.ScheduleTypeName</span></td>
                                    <td>@item.AssignedToUserName</td>
                                    <td><span class="badge bg-primary">@item.StatusName</span></td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Details", "Schedules", new { id = item.ScheduleID })" class="btn btn-sm btn-outline-info" title="Xem">👁️</a>
                                        <a href="@Url.Action("Edit", "Schedules", new { id = item.ScheduleID })" class="btn btn-sm btn-outline-warning" title="Sửa">✏️</a>
                                        <button class="btn btn-sm btn-outline-success" title="Hoàn thành">✅</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">Chưa có dữ liệu lịch hẹn</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
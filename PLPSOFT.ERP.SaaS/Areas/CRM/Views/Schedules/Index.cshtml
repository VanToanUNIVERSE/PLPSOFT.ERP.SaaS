    @model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Danh sách Lịch chăm sóc";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Quản lý Lịch làm việc & Nhắc hẹn</h1>
        <a href="@Url.Action("Create", "Schedules")" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Tạo lịch hẹn mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-body">
            <form class="row g-3" method="get" asp-action="Index">
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Trạng thái</label>
                    <select class="form-select border-left-info" name="statusID">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="16" selected="@(ViewBag.StatusID == 16 ? "selected" : null)">Đã lên lịch (PLANNED)</option>
                        <option value="17" selected="@(ViewBag.StatusID == 17 ? "selected" : null)">Hoàn thành (COMPLETED)</option>
                        <option value="18" selected="@(ViewBag.StatusID == 18 ? "selected" : null)">Đã hủy (CANCELED)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Loại lịch</label>
                    <select class="form-select" name="scheduleTypeID" asp-items="@(new SelectList(ViewBag.ScheduleTypes, "Value", "Text", ViewBag.ScheduleTypeID))">
                        <option value="">-- Tất cả loại --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Người phụ trách</label>
                    <select class="form-select" name="assignedToUserID" asp-items="@(new SelectList(ViewBag.Users, "Value", "Text", ViewBag.AssignedToUserID))">
                        <option value="">-- Tất cả nhân viên --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Lọc theo thời gian</label>
                    <select class="form-select" name="timeFilter">
                        <option value="">-- Tất cả --</option>
                        <option value="overdue" selected="@(ViewBag.TimeFilter == "overdue" ? "selected" : null)">Quá hạn (Chưa hoàn thành)</option>
                        <option value="upcoming_day" selected="@(ViewBag.TimeFilter == "upcoming_day" ? "selected" : null)">Sắp tới (Hôm nay)</option>
                        <option value="upcoming_week" selected="@(ViewBag.TimeFilter == "upcoming_week" ? "selected" : null)">Sắp tới (Tuần này)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-secondary flex-grow-1">
                        <i class="fas fa-filter fa-sm me-1"></i>Lọc lịch
                    </button>
                    @{
                        bool hasFilter = ViewBag.StatusID != null && ViewBag.StatusID != 0
                                      || ViewBag.ScheduleTypeID != null && ViewBag.ScheduleTypeID != 0
                                      || ViewBag.AssignedToUserID != null && ViewBag.AssignedToUserID != 0
                                      || !string.IsNullOrEmpty(ViewBag.TimeFilter as string);
                    }
                    @if (hasFilter)
                    {
                        <a href="@Url.Action("Index", "Schedules")" class="btn btn-outline-danger" title="Xóa bộ lọc">
                            <i class="fas fa-times"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-success">Lịch làm việc chi tiết</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Thời gian bắt đầu</th>
                            <th>Tiêu đề công việc</th>
                            <th>Khách hàng</th>
                            <th>Loại lịch</th>
                            <th>Người phụ trách</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StartTime</td>
                                    <td><strong>@item.Title</strong></td>
                                    <td>@item.CustomerName</td>
                                    <td><span class="badge bg-info">@item.ScheduleTypeName</span></td>
                                    <td>@item.AssignedToUserName</td>
                                    <td><span class="badge bg-primary">@item.StatusName</span></td>
                                     <td class="text-center">
                                         <div class="" role="group">
                                             <a href="@Url.Action("Details", "Schedules", new { id = item.ScheduleID })" class="btn btn-sm btn-info text-white me-2" title="Xem chi tiết">
                                                 <i class="fas fa-eye"></i>
                                             </a>
                                             <a href="@Url.Action("Edit", "Schedules", new { id = item.ScheduleID })" class="btn btn-sm btn-warning text-white me-2" title="Sửa">
                                                 <i class="fas fa-edit"></i>
                                             </a>
                                             @if (item.StatusCode == "PLANNED")
                                             {
                                                 <form asp-action="Complete" asp-route-id="@item.ScheduleID" method="post" style="display:inline" data-confirm="Xác nhận đánh dấu hoàn thành lịch hẹn này?">
                                                     @Html.AntiForgeryToken()
                                                     <button type="submit" class="btn btn-sm btn-success text-white me-2" title="Hoàn thành">
                                                         <i class="fas fa-check"></i>
                                                     </button>
                                                 </form>
                                                 <form asp-action="Cancel" asp-route-id="@item.ScheduleID" method="post" style="display:inline" data-confirm="Xác nhận hủy lịch hẹn này?">
                                                     @Html.AntiForgeryToken()
                                                     <button type="submit" class="btn btn-sm btn-secondary text-white me-2" title="Hủy lịch">
                                                         <i class="fas fa-times"></i>
                                                     </button>
                                                 </form>
                                             }
                                             <form asp-action="Delete" asp-route-id="@item.ScheduleID" method="post" style="display:inline" data-confirm="Xác nhận xóa lịch hẹn này?">
                                                 @Html.AntiForgeryToken()
                                                 <button type="submit" class="btn btn-sm btn-danger text-white me-2" title="Xóa">
                                                     <i class="fas fa-trash"></i>
                                                 </button>
                                             </form>
                                         </div>
                                     </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">Chưa có dữ liệu lịch hẹn</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
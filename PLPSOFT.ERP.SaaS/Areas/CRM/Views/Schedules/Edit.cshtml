@model PLPSOFT.ERP.SaaS.Modules.CRM.Application.DTOs.ScheduleFormViewModel

@{
    ViewData["Title"] = "Cập nhật Lịch chăm sóc";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Cập nhật Lịch làm việc & Nhắc hẹn</h1>
        <a href="@Url.Action("Index", "Schedules")" class="btn btn-secondary btn-sm shadow-sm">Quay lại danh sách</a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-success">Chi tiết lịch hẹn và cập nhật trạng thái</h6>
        </div>
        <div class="card-body">
            <form asp-controller="Schedules" asp-action="Edit" method="post">
                <input type="hidden" asp-for="UpdateDto.ScheduleID" />
                <input type="hidden" asp-for="UpdateDto.BranchID" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger shadow-sm">
                        <i class="fas fa-exclamation-triangle me-2"></i> Có lỗi xảy ra, vui lòng kiểm tra lại thông tin!
                        <div asp-validation-summary="All" class="text-danger mt-2 mb-0"></div>
                    </div>
                }

                <div class="row mb-3">
                    <div class="col-md-12">
                        <label asp-for="UpdateDto.CustomerID" class="form-label fw-bold">Khách hàng <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="UpdateDto.CustomerID" asp-items="@(new SelectList(Model?.Customers, "Value", "Text"))">
                            <option value="">-- Chọn khách hàng --</option>
                        </select>
                        <span asp-validation-for="UpdateDto.CustomerID" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="UpdateDto.ScheduleTypeID" class="form-label fw-bold">Loại lịch <span class="text-danger">*</span></label>
                        <select class="form-select border-success" asp-for="UpdateDto.ScheduleTypeID" asp-items="@(new SelectList(Model?.ScheduleTypes, "Value", "Text"))">
                            <option value="">-- Chọn loại lịch --</option>
                        </select>
                        <span asp-validation-for="UpdateDto.ScheduleTypeID" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="UpdateDto.AssignedToUserID" class="form-label fw-bold">Người phụ trách <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="UpdateDto.AssignedToUserID" asp-items="@(new SelectList(Model?.Users, "Value", "Text"))">
                            <option value="">-- Chọn nhân viên --</option>
                        </select>
                        <span asp-validation-for="UpdateDto.AssignedToUserID" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="UpdateDto.Title" class="form-label fw-bold">Tiêu đề công việc <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" asp-for="UpdateDto.Title" placeholder="Nhập tiêu đề công việc...">
                    <span asp-validation-for="UpdateDto.Title" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="UpdateDto.StartTime" class="form-label fw-bold">Thời gian bắt đầu <span class="text-danger">*</span></label>
                        <input type="datetime-local" class="form-control" asp-for="UpdateDto.StartTime">
                        <span asp-validation-for="UpdateDto.StartTime" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="UpdateDto.EndTime" class="form-label fw-bold">Thời gian kết thúc <span class="text-danger">*</span></label>
                        <input type="datetime-local" class="form-control" asp-for="UpdateDto.EndTime">
                        <span asp-validation-for="UpdateDto.EndTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="UpdateDto.Description" class="form-label fw-bold">Mô tả chi tiết</label>
                    <textarea class="form-control" asp-for="UpdateDto.Description" rows="4"></textarea>
                    <span asp-validation-for="UpdateDto.Description" class="text-danger"></span>
                </div>

                <hr>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success px-4">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
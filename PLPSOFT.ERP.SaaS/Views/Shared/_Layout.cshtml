<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PLPSOFT.ERP.SaaS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PLPSOFT.ERP.SaaS.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3" style="background-color: #1a365d;">
            <div class="container-fluid px-4">
                <a class="navbar-brand text-white font-weight-bold" style="font-weight: 700; letter-spacing: 0.5px;" asp-area="" asp-controller="Home" asp-action="Index">PLPSOFT CRM</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="CRM" asp-controller="CustomerTimeline" asp-action="Details" asp-route-id="1">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" href="#">Phản hồi và Khiếu nại</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" href="#">Lịch chăm sóc</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-white-50">
                        <span class="me-3" style="cursor: pointer; font-size: 1.1rem;">
                            🔔
                        </span>
                        <span style="font-size: 0.95rem;">Xin chào, <strong class="text-white">Admin</strong></span>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PLPSOFT.ERP.SaaS - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

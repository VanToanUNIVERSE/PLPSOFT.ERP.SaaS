<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PLPSOFT.ERP.SaaS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PLPSOFT.ERP.SaaS.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">PLPSOFT.ERP.SaaS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">
                                CRM
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="CRM" asp-controller="Schedules" asp-action="Index">📋 Danh sách lịch</a></li>
                                <li><a class="dropdown-item" asp-area="CRM" asp-controller="Schedules" asp-action="Create">➕ Tạo lịch mới</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-area="CRM" asp-controller="Schedules" asp-action="Overdue">⚠️ Lịch quá hạn</a></li>
                                <li><a class="dropdown-item" asp-area="CRM" asp-controller="Schedules" asp-action="Upcoming">📅 Lịch sắp tới</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <!-- Nút chuông nhắc hẹn -->
                    <div class="d-flex align-items-center">
                        <div class="position-relative" id="reminderBellContainer">
                            <button class="btn btn-outline-secondary position-relative" id="btnReminderBell" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false" title="Nhắc hẹn lịch chăm sóc">
                                🔔
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="reminderBadge">
                                    0
                                </span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end reminder-dropdown" id="reminderDropdown" style="min-width: 380px; max-height: 400px; overflow-y: auto;">
                                <h6 class="dropdown-header">🔔 Nhắc hẹn lịch chăm sóc</h6>
                                <div id="reminderList">
                                    <div class="text-center text-muted py-3">
                                        <small>Đang tải...</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PLPSOFT.ERP.SaaS - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Toast container cho nhắc hẹn -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index: 9999;"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/reminders.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
